# Copy this file to .kamal/deploy.env, fill in your deployment identifiers,
# then run `set -a; source .kamal/deploy.env; set +a` before Kamal commands.
KAMAL_SERVICE=thinkroom
KAMAL_IMAGE=your-github-user/thinkroom
KAMAL_HOSTS=your-server.example.com
KAMAL_PROXY_HOSTS=thinkroom.example.com
KAMAL_REGISTRY_SERVER=ghcr.io
KAMAL_REGISTRY_USERNAME=your-github-user
KAMAL_STORAGE_VOLUME=thinkroom_storage
KAMAL_BUILDER_ARCH=amd64
KAMAL_SSH_USER=root

# Comma-separated accounts allowed to upload Riffrec bundles and start Cursor.
# RIFFREC_AUTOMATION_EMAILS=maintainer@example.com

# Public Chrome origin-trial token for WebMCP; register both production origins.
# WEBMCP_ORIGIN_TRIAL_TOKEN=

# Optional: include GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET from
# .kamal/secrets in the deployed container.
# KAMAL_GOOGLE_OAUTH=1

# Optional: include TYPESAFE_API_KEY from .kamal/secrets so compound writing
# can run its reviewers in production, and name the accounts the boot
# migration grants the feature and the first pack to (comma-separated).
# KAMAL_COMPOUND_WRITING=1
# COMPOUND_WRITING_INITIAL_ACCOUNTS=you@example.com

# Optional: build on a remote Docker host instead of the local machine.
# KAMAL_BUILDER_REMOTE=ssh://root@your-server.example.com
