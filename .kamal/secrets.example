# Copy these names into .kamal/secrets and resolve values from your shell or
# password manager. Never put literal production credentials in this file.
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
RAILS_MASTER_KEY=$RAILS_MASTER_KEY
CURSOR_API_KEY=$CURSOR_API_KEY
GOOGLE_CLIENT_ID=$GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=$GOOGLE_CLIENT_SECRET
# Compound writing (TypeSafe's Jev): required on every deploy. bin/typesafe-key
# prints the exported TYPESAFE_API_KEY or the value from this checkout's
# untracked .env, and fails the deploy (via .kamal/hooks/pre-build) when
# neither has it.
TYPESAFE_API_KEY=$(bin/typesafe-key)
