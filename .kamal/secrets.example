# Copy these names into .kamal/secrets and resolve values from your shell or
# password manager. Never put literal production credentials in this file.
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
RAILS_MASTER_KEY=$RAILS_MASTER_KEY
CURSOR_API_KEY=$CURSOR_API_KEY
GOOGLE_CLIENT_ID=$GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=$GOOGLE_CLIENT_SECRET
# Compound writing mode (TypeSafe's Jev). Deployed only when
# KAMAL_COMPOUND_WRITING=1 is set in .kamal/deploy.env.
TYPESAFE_API_KEY=$TYPESAFE_API_KEY
